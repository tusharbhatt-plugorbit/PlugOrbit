# Copy to `.env` (git-ignored) and fill in. Keep each entry as plain NAME=value
# (no `export`, no spaces around `=`, no trailing # comment): the native Gradle and
# CocoaPods steps read exactly that form. After editing, restart Metro with
# `npm start -- --reset-cache`, re-run `pod install` (iOS) and rebuild the app so
# the native Google Maps SDKs pick the keys up too.
#
# A Google API key can only carry ONE kind of application restriction, so use
# separate keys (see README "Google Maps, location & nearby chargers"):

# Maps SDK for Android: restrict to the Android app (package + SHA-1) and to
# "Maps SDK for Android".
GOOGLE_MAPS_ANDROID_KEY=

# Maps SDK for iOS: restrict to the iOS bundle ID and to "Maps SDK for iOS".
GOOGLE_MAPS_IOS_KEY=

# Places API (New), called with a plain HTTPS request from the app. App
# restrictions can't be applied to REST calls, so restrict this one to the
# "Places API (New)" API only, set a low quota, or (better) proxy Places through
# the Backend and keep the key server-side.
GOOGLE_PLACES_API_KEY=

# Local-development shortcut: used for any of the three above that is empty.
# Use an unrestricted dev key here only; never ship it.
GOOGLE_MAPS_API_KEY=

# Fallback map (Android build with no Google Maps key above). Leave empty to use the
# public OpenStreetMap tiles, fine for development and demos but not for heavy or
# commercial use (https://operations.osmfoundation.org/policies/tiles/). For a real
# launch set a Google Maps key instead, or a tile provider you have an agreement
# with: MAP_TILE_URL uses {z}/{x}/{y} placeholders, MAP_TILE_ATTRIBUTION is HTML.
# MAP_TILE_REFERER is the https address sent as the Referer with every tile request
# (OpenStreetMap refuses tiles without one). Empty uses this project's GitHub page;
# for a real launch set your own site.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_REFERER=

# Base URL of the PlugOrbit Backend, used for the login OTP (see README "Login OTP
# (development)"). Leave empty for the defaults: http://10.0.2.2:8000 on the Android
# emulator (its alias for your computer) and http://localhost:8000 on the iOS
# simulator. A real phone needs your computer's LAN IP, e.g. http://192.168.1.20:8000,
# and the Backend started with `uvicorn app.main:app --host 0.0.0.0`.
API_BASE_URL=
