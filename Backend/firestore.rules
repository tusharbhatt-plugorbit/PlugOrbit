rules_version = '2';

// No client may read or write Firestore directly. All access goes through the PlugOrbit
// Backend, which uses the Firebase Admin SDK (the Admin SDK bypasses these rules) and
// authorises every request with the caller's verified Firebase ID token, scoped to
// users/{uid}. This is identical to the rules already live in project plugorbit-fb178.
//
// To let the mobile app talk to Firestore directly instead, replace this with per-user
// rules (match /users/{uid}/{document=**} { allow read, write: if request.auth.uid == uid; })
// and add the Firebase client SDK to the app. Do that deliberately, not as a shortcut.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
