# --- Firebase (project plugorbit-fb178) ----------------------------------------------
# Web API key (not a secret, but required by login/signup): Firebase Console > Project
# settings > General > "Web API Key". Needs Authentication to be set up first.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Admin credentials: the service-account key is a SECRET. Use ONE of these; the first
# one found wins. Never commit it, never put it in the mobile app.
# 1. Local development: save the downloaded key as Backend/serviceAccountKey.json
#    (git-ignored), or point to it elsewhere (absolute path, or relative to Backend/).
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# 2. Hosts that keep secrets in environment variables: the key's JSON, or that JSON
#    base64-encoded (prefer base64 inside a .env file: `base64 -w0 key.json`).
# FIREBASE_CREDENTIALS_JSON=
# 3. Google Cloud (Cloud Run, GCE, `gcloud auth application-default login`): no key at all.
# FIREBASE_USE_ADC=true
# FIREBASE_PROJECT_ID=plugorbit-fb178

CORS_ORIGINS=["*"]

# --- Login / signup OTP ---------------------------------------------------------
# The app asks the user for a code after they type an email or a mobile number.
# Typed an email  -> the code is emailed (needs SMTP_* below).
# Typed a number  -> the code is texted  (needs TWILIO_* below).
# If that is not configured or fails, and OTP_DEV_FALLBACK=true, the code is returned
# to the app and shown on screen instead. Codes are kept in memory (single process).

# Code length. The app's code boxes expect 6 digits, keep it at 6.
OTP_LENGTH=6
# How long a code stays valid, in seconds.
OTP_TTL_SECONDS=300
# Cooldown before another code can be requested, in seconds. 0 disables it.
OTP_RESEND_SECONDS=30
# Wrong tries before the code is invalidated.
OTP_MAX_ATTEMPTS=5

# DEV ONLY. true = when a code cannot be emailed/texted, send it back in the API
# response and log it so a developer is never stuck. That lets anyone who can reach the
# API read the code, so it MUST be false anywhere but a local dev machine. With false, a
# failed delivery answers 503 OTP_DELIVERY_FAILED instead.
OTP_DEV_FALLBACK=true

# DEV ONLY. With Firebase configured, a verified code opens a Firebase session for the user
# and the app backs its data up to their account. A code shown on screen (OTP_DEV_FALLBACK)
# proves nothing about the inbox/phone, so by default it signs the app in on the device only
# and opens NO Firebase session; otherwise anyone who can reach the API could read any
# account's data. Set true on a local dev machine with no email/SMS to try cloud backup.
# MUST be false (the default) on anything reachable by others.
OTP_DEV_FALLBACK_SESSIONS=false

# Added in front of mobile numbers typed without a country code (e.g. 98765 43210).
DEFAULT_COUNTRY_CODE=+91

# Email delivery over SMTP with STARTTLS. Active as soon as SMTP_HOST is set.
# Gmail example: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste it without spaces (your normal
# Google password will not work), then fill in the SMTP_* lines below:
# SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<the app password>
# (SMTP_PORT stays 587, SMTP_FROM can stay empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address. Defaults to SMTP_USERNAME when empty.
SMTP_FROM=
# true = STARTTLS (port 587).
SMTP_USE_TLS=true

# SMS delivery through Twilio. Active when all three of these are set. A Twilio trial
# account can only text numbers you verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 form, e.g. +15005550006.
TWILIO_FROM_NUMBER=
TWILIO_API_BASE=https://api.twilio.com
